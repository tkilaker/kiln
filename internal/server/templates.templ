package server

import (
	"github.com/tkilaker/kiln/internal/database"
	"github.com/tkilaker/kiln/internal/tts"
	"fmt"
)

// TTSInfo holds TTS state passed to templates
type TTSInfo struct {
	Enabled  bool
	Voices   []tts.Voice
}

// Layout is the base HTML template
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - Kiln</title>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
			<script src="https://cdn.tailwindcss.com"></script>
			<style>
				.htmx-indicator { display: none; }
				.htmx-request .htmx-indicator { display: inline-block; }
				.htmx-request.htmx-indicator { display: inline-block; }
			</style>
		</head>
		<body class="bg-gray-50">
			<nav class="bg-white shadow-sm mb-8">
				<div class="max-w-4xl mx-auto px-4 py-4">
					<div class="flex justify-between items-center">
						<h1 class="text-2xl font-bold text-gray-900">
							<a href="/">Kiln</a>
						</h1>
						<div class="flex gap-4">
							<a href="/articles" class="text-gray-600 hover:text-gray-900">Articles</a>
							<a href="/rss.xml" class="text-gray-600 hover:text-gray-900">RSS</a>
							<a href="/podcast.xml" class="text-gray-600 hover:text-gray-900">Podcast</a>
						</div>
					</div>
				</div>
			</nav>
			<main class="max-w-4xl mx-auto px-4">
				{ children... }
			</main>
		</body>
	</html>
}

// ArticleListPage renders the list of articles
templ ArticleListPage(articles []*database.Article, audioMap map[int]*database.AudioFile, ttsInfo TTSInfo) {
	@Layout("Articles") {
		<div class="mb-6 flex justify-between items-center">
			<h2 class="text-3xl font-bold text-gray-900">Articles</h2>
			<div class="flex gap-2">
				<button
					hx-post="/scrape"
					hx-target="#scrape-result"
					hx-swap="innerHTML"
					hx-disabled-elt="this"
					hx-indicator="#scrape-spinner"
					class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium disabled:opacity-50 disabled:cursor-not-allowed"
				>
					<span class="inline-flex items-center gap-2">
						<span id="scrape-spinner" class="htmx-indicator">
							<svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</span>
						<span>Scrape New Articles</span>
					</span>
				</button>
				if len(articles) > 0 {
					<button
						hx-post="/articles/clear"
						hx-target="#scrape-result"
						hx-swap="innerHTML"
						hx-confirm="Are you sure you want to delete all articles? This cannot be undone."
						class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium"
					>
						Clear All
					</button>
				}
			</div>
		</div>
		<div id="scrape-result" class="mb-4"></div>
		if len(articles) == 0 {
			<div class="text-center py-12">
				<p class="text-gray-500 text-lg">No articles yet. Click "Scrape New Articles" to get started!</p>
			</div>
		} else {
			<div class="space-y-4">
				for _, article := range articles {
					@ArticleCardWithAudio(article, audioMap[article.ID], ttsInfo.Enabled)
				}
			</div>
		}
	}
}

// ArticleCardWithAudio renders an article card with optional audio indicator
templ ArticleCardWithAudio(article *database.Article, audio *database.AudioFile, ttsEnabled bool) {
	<div class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition-shadow relative" id={ fmt.Sprintf("article-%d", article.ID) }>
		<button
			hx-delete={ fmt.Sprintf("/articles/%d", article.ID) }
			hx-target={ fmt.Sprintf("#article-%d", article.ID) }
			hx-swap="outerHTML"
			hx-confirm="Are you sure you want to delete this article?"
			class="absolute top-4 right-4 text-gray-400 hover:text-red-600 transition-colors"
			title="Delete article"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<a href={ templ.URL(fmt.Sprintf("/articles/%d", article.ID)) } class="block pr-8">
			<h3 class="text-xl font-semibold text-gray-900 mb-2">
				if article.Title != nil {
					{ *article.Title }
				} else {
					Untitled Article
				}
			</h3>
			<div class="flex gap-4 text-sm text-gray-600 mb-3">
				if article.Author != nil {
					<span>By { *article.Author }</span>
				}
				if article.PublishedAt != nil {
					<span>{ article.PublishedAt.Format("January 2, 2006") }</span>
				} else {
					<span>{ article.CreatedAt.Format("January 2, 2006") }</span>
				}
				if audio != nil && audio.Status == "completed" {
					<span class="text-green-600 flex items-center gap-1">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.707.707L4.586 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.586l3.707-3.707a1 1 0 011.09-.217zM14.657 2.929a1 1 0 011.414 0A9.972 9.972 0 0119 10a9.972 9.972 0 01-2.929 7.071 1 1 0 01-1.414-1.414A7.971 7.971 0 0017 10c0-2.21-.894-4.208-2.343-5.657a1 1 0 010-1.414zm-2.829 2.828a1 1 0 011.415 0A5.983 5.983 0 0115 10a5.984 5.984 0 01-1.757 4.243 1 1 0 01-1.415-1.415A3.984 3.984 0 0013 10a3.983 3.983 0 00-1.172-2.828 1 1 0 010-1.415z" clip-rule="evenodd"></path>
						</svg>
						Audio
					</span>
				}
			</div>
			if article.ContentText != nil {
				<p class="text-gray-700 line-clamp-3">
					{ truncate(*article.ContentText, 200) }
				</p>
			}
		</a>
	</div>
}

// ArticleCard renders a single article card (used by SSE for new articles)
templ ArticleCard(article *database.Article) {
	@ArticleCardWithAudio(article, nil, false)
}

// ArticleDetailPage renders a single article in detail
templ ArticleDetailPage(article *database.Article, audioFiles []*database.AudioFile, ttsInfo TTSInfo) {
	@Layout(getTitle(article)) {
		<article class="bg-white rounded-lg shadow-sm p-8">
			<div class="mb-6">
				<a href="/articles" class="text-blue-600 hover:text-blue-800 text-sm">&larr; Back to articles</a>
			</div>
			<header class="mb-8">
				<h1 class="text-4xl font-bold text-gray-900 mb-4">
					if article.Title != nil {
						{ *article.Title }
					} else {
						Untitled Article
					}
				</h1>
				<div class="flex gap-4 text-gray-600">
					if article.Author != nil {
						<span>By { *article.Author }</span>
					}
					if article.PublishedAt != nil {
						<span>{ article.PublishedAt.Format("January 2, 2006") }</span>
					} else {
						<span>{ article.CreatedAt.Format("January 2, 2006") }</span>
					}
				</div>
				<div class="mt-2 text-sm text-gray-500">
					<a href={ templ.URL(article.URL) } target="_blank" class="hover:text-gray-700">
						View original &rarr;
					</a>
				</div>
			</header>
			// TTS Audio Section
			if ttsInfo.Enabled {
				<div class="mb-8 p-4 bg-gray-50 rounded-lg border" id={ fmt.Sprintf("tts-section-%d", article.ID) }>
					<h3 class="text-sm font-semibold text-gray-700 mb-3">Listen to this article</h3>
					if hasCompletedAudio(audioFiles) {
						for _, af := range audioFiles {
							if af.Status == "completed" {
								@AudioPlayer(article.ID, af)
							}
						}
						if len(ttsInfo.Voices) > 1 {
							<div class="mt-3 border-t pt-3">
								<details class="text-sm text-gray-500">
									<summary class="cursor-pointer hover:text-gray-700">Generate with a different voice</summary>
									<div class="mt-2">
										@VoiceSelector(article.ID, ttsInfo.Voices)
									</div>
								</details>
							</div>
						}
					} else {
						@VoiceSelector(article.ID, ttsInfo.Voices)
					}
				</div>
			}
			<div class="prose prose-lg max-w-none">
				if article.ContentHTML != nil {
					@templ.Raw(*article.ContentHTML)
				} else if article.ContentText != nil {
					<p>{ *article.ContentText }</p>
				} else {
					<p class="text-gray-500">No content available</p>
				}
			</div>
		</article>
	}
}

// AudioPlayer renders an audio player for a completed audio file
templ AudioPlayer(articleID int, audio *database.AudioFile) {
	<div class="flex items-center gap-2 mb-2" id={ fmt.Sprintf("tts-result-%d", articleID) }>
		<span class="text-xs text-gray-500 bg-gray-200 px-2 py-0.5 rounded">{ audio.Voice }</span>
		<audio controls class="flex-1 h-8" preload="metadata">
			<source src={ fmt.Sprintf("/articles/%d/audio?voice=%s", articleID, audio.Voice) } type="audio/mpeg"/>
		</audio>
	</div>
}

// VoiceSelector renders a voice selection form for TTS generation
templ VoiceSelector(articleID int, voices []tts.Voice) {
	<div class="flex items-center gap-2 flex-wrap">
		<label class="text-sm text-gray-600">Voice:</label>
		<form class="flex items-center gap-2 flex-wrap">
			<select
				name="voice"
				id={ fmt.Sprintf("voice-select-%d", articleID) }
				class="text-sm border border-gray-300 rounded px-2 py-1 bg-white"
			>
				for _, v := range voices {
					<option value={ v.ID }>{ v.Name }</option>
				}
			</select>
			<button
				type="button"
				hx-post={ fmt.Sprintf("/articles/%d/tts", articleID) }
				hx-target={ fmt.Sprintf("#tts-section-%d", articleID) }
				hx-swap="innerHTML"
				hx-include={ fmt.Sprintf("#voice-select-%d", articleID) }
				class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm font-medium"
			>
				Generate Audio
			</button>
		</form>
	</div>
}

// Helper functions
func getTitle(article *database.Article) string {
	if article.Title != nil {
		return *article.Title
	}
	return "Untitled Article"
}

func truncate(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen] + "..."
}

func hasCompletedAudio(audioFiles []*database.AudioFile) bool {
	for _, af := range audioFiles {
		if af.Status == "completed" {
			return true
		}
	}
	return false
}
